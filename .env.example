# ============================================================
# Configurações do Instagram Supermarket Flyers Scraper
# Copie este arquivo para .env e preencha suas chaves
# ============================================================

# Token do Apify (obtenha em https://console.apify.com/account/integrations)
APIFY_TOKEN=seu_token_apify_aqui

# Provedor de IA para Visão: "gemini", "openai" ou "qwen"
VISION_PROVIDER=gemini

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# (Opcional) Chave da OpenAI se preferir usar GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# (Opcional) Modelo específico do Gemini (ex: gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-3.5-flash

# Porta do Servidor Web local
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
