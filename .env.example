# ============================================================
# Configurações do Instagram Supermarket Flyers Scraper
# Copie este arquivo para .env e preencha suas chaves
# ============================================================

# Token do Apify (obtenha em https://console.apify.com/account/integrations)
APIFY_TOKEN=seu_token_apify_aqui

# Provedor de IA para Visão: "gemini" ou "openai"
VISION_PROVIDER=gemini

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# (Opcional) Chave da OpenAI se preferir usar GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# (Opcional) Modelo específico do Gemini (ex: gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Notificações no Telegram (Bot & Alertas Diários)
# ============================================================
# Token do bot criado no @BotFather (ex: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Chat ID do seu usuário, grupo ou canal (ex: 987654321 ou -100123456789)
TELEGRAM_CHAT_ID=

# Ativar envio de alertas (true ou false)
TELEGRAM_ENABLED=true

# Enviar planilha Excel em anexo no Telegram (true ou false)
TELEGRAM_SEND_EXCEL=true

# ============================================================
# Configurações do Servidor Web Local
# ============================================================
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
